# 复制为 .env.local 后填入真实值:  cp .env.local.example .env.local
# 带 NEXT_PUBLIC_ 前缀的变量会进入浏览器;密钥绝不能加该前缀。

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # 仅服务端,绝不暴露给前端

# Sightengine (https://dashboard.sightengine.com)
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# 多模态大模型(二选一,留空则水印检测走 mock)
GOOGLE_API_KEY=                   # Gemini 2.5 Flash(推荐,性价比高)
# OPENAI_API_KEY=                 # 或 GPT-4o
