# 复制为 .env.local 后填入真实值:  cp .env.local.example .env.local
# 带 NEXT_PUBLIC_ 前缀的变量会进入浏览器;密钥绝不能加该前缀。

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # 仅服务端,绝不暴露给前端

# Sightengine (https://dashboard.sightengine.com)
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# 视觉大模型(图像分析 + 水印/厂商/人脸判别;建议都配,多模型投票)
OPENAI_API_KEY=                   # GPT-4o(视觉)
GOOGLE_API_KEY=                   # Gemini 2.5 Flash(视觉)
# 文本大模型(聚合视觉投票、裁决水印厂商与真假脸;DeepSeek 仅文本)
DEEPSEEK_API_KEY=                 # DeepSeek
# 裁决模型:默认 deepseek-chat;设为 deepseek-reasoner 用「pro」推理模型(更慢但更强)
# DEEPSEEK_MODEL=deepseek-reasoner
